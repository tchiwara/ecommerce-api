# Copy this file to .env and fill in the values. Never commit .env.

# --- Database ---
# For running the app directly with Maven (Docker Compose overrides this with mysql:3306)
DB_URL=jdbc:mysql://localhost:3307/ecommerce_db
# Use root: the compose MySQL container sets DB_PASSWORD as the root password
DB_USERNAME=root
# Any password you choose; MySQL uses it the first time its data volume is created
DB_PASSWORD=change-me

# --- Security ---
# Long random strings. Generate each with: openssl rand -base64 48
JWT_SECRET=
OTP_SECRET=

# --- Email (OTP verification and order confirmation, via Gmail SMTP) ---
# Your Gmail address and a Gmail App Password (not your normal password)
MAIL_USERNAME=
MAIL_PASSWORD=

# --- Stripe (test mode) ---
# From dashboard.stripe.com/test/apikeys, starts with sk_test_
STRIPE_SECRET_KEY=
# Printed by `stripe listen`, starts with whsec_
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:8080/payment-success.html
STRIPE_CANCEL_URL=http://localhost:8080/payment-cancelled.html
STRIPE_CURRENCY=usd